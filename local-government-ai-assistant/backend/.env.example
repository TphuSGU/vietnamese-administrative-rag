# ============================================================================
# RAG System Configuration for Vietnamese Government Documents
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# ============================================================================

# Google Gemini Configuration (NOT OpenAI)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-exp

# Vietnamese Embedding Model (bkai-foundation-models/vietnamese-bi-encoder)
EMBEDDING_MODEL_NAME=bkai-foundation-models/vietnamese-bi-encoder
# Optional: Local path to model (if not provided, will download from HuggingFace)
# EMBEDDING_MODEL_PATH=/path/to/local/model
EMBEDDING_DIM=768

# Chunking Parameters
CHUNK_MIN_SIZE=200
CHUNK_MAX_SIZE=1000

# Retrieval Parameters
DEFAULT_K=5
MAX_K=20
MIN_K=1

# Vector Store (ChromaDB)
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=documents

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO

# File Upload Limits
MAX_FILE_SIZE_MB=50

# Query Constraints
MIN_QUERY_LENGTH=10
MAX_QUERY_LENGTH=500

# LLM Generation Parameters
MAX_TOKENS=500
TEMPERATURE=0.3

# Concurrency
MAX_CONCURRENT_INGESTION=4
EMBEDDING_BATCH_SIZE=32
