# ============================================================================
# RAG System Configuration for Vietnamese Government Documents
# ============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# ============================================================================

# Google Gemini Configuration (NOT OpenAI)
GEMINI_API_KEY=getapikey 
GEMINI_MODEL=gemini-3.5-flash-lite

# Vietnamese Embedding Model (bkai-foundation-models/vietnamese-bi-encoder)
EMBEDDING_MODEL_NAME=bkai-foundation-models/vietnamese-bi-encoder
# Optional: Local path to model (if not provided, will download from HuggingFace)
# EMBEDDING_MODEL_PATH=/path/to/local/model
EMBEDDING_DIM=768

# Chunking Parameters
CHUNK_MIN_SIZE=200
CHUNK_MAX_SIZE=1000

# OCR fallback for scanned PDFs (apt install tesseract-ocr tesseract-ocr-vie)
OCR_ENABLED=true
OCR_LANG=vie
OCR_DPI=300
OCR_MIN_CHARS_PER_PAGE=50
OCR_MAX_PAGES=0

# Retrieval Parameters
DEFAULT_K=5
MAX_K=20
MIN_K=1

# Vector Store (ChromaDB)
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION=documents

# PostgreSQL + JWT (apt install postgresql postgresql-contrib)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/assistant_db
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated origins; "*" allows all but disables credentials
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO

# File Upload Limits
MAX_FILE_SIZE_MB=50

# Query Constraints
MIN_QUERY_LENGTH=10
MAX_QUERY_LENGTH=500

# LLM Generation Parameters
MAX_TOKENS=500
TEMPERATURE=0.3

# Concurrency
MAX_CONCURRENT_INGESTION=4
EMBEDDING_BATCH_SIZE=32

# BM25S Configuration (Hybrid Search)
BM25S_PERSIST_DIR=./bm25s_index
BM25S_K1=1.5
BM25S_B=0.75
